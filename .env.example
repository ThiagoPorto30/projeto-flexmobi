# Domínio HTTPS oficial, sem caminho. Deixe vazio no protótipo.
SITE_URL=
# Ative somente após validar conteúdo, preços, contato e privacidade.
# Em Vercel Preview e em next dev a indexação continua desativada.
SITE_INDEXABLE=false

# Dados públicos. Alterações exigem um novo build.
# WhatsApp: código do país 55 + DDD + número, apenas dígitos.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CNPJ=
# Texto aprovado pela equipe, incluindo dias/horários quando necessário.
NEXT_PUBLIC_RESPONSE_TIME=
